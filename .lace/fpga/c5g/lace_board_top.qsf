# Generated by Lace from fpga.json: the Quartus project of the board
# Terasic Cyclone V GX Starter Kit (C5G) (c5g) for the top proc_placa.
# Lace writes it again on every build: do not edit.

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CGXFC5C6F27C7
set_global_assignment -name TOP_LEVEL_ENTITY lace_board_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

# Unused pins: inputs, tri-stated, with the weak pull-up. They never
# drive what the board connects to them.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED WITH WEAK PULL-UP"

# Programming files: the .sof for quartus_pgm and, for openFPGALoader,
# the .rbf and the .svf, uncompressed (the FPGA does not decompress
# over JTAG).
set_global_assignment -name ON_CHIP_BITSTREAM_DECOMPRESSION OFF
set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name GENERATE_SVF_FILE ON

# The sources in order, then the board top and the clocks.
set_global_assignment -name SEARCH_PATH "C:/Users/Aluno/Projetos/port_CycloneV_acc"
set_global_assignment -name VERILOG_FILE "C:/Users/Aluno/Projetos/port_CycloneV_acc/proc_placa.v"
set_global_assignment -name VERILOG_FILE "C:/Users/Aluno/Projetos/port_CycloneV_acc/my_proc.v"
set_global_assignment -name VERILOG_FILE "C:/Users/Aluno/Projetos/port_CycloneV_acc/acumulador.v"
set_global_assignment -name VERILOG_FILE "C:/Users/Aluno/Projetos/port_CycloneV_acc/conta_apertos.v"
set_global_assignment -name VERILOG_FILE "C:/Users/Aluno/Projetos/port_CycloneV_acc/debounce.v"
set_global_assignment -name VERILOG_FILE "C:/Users/Aluno/Projetos/port_CycloneV_acc/decimal16_dabble.v"
set_global_assignment -name VERILOG_FILE "C:/Users/Aluno/Projetos/port_CycloneV_acc/dig7.v"
set_global_assignment -name VERILOG_FILE "C:/Users/Aluno/Projetos/port_CycloneV_acc/display5.v"
set_global_assignment -name VERILOG_FILE "C:/Users/Aluno/Projetos/port_CycloneV_acc/ula16s.v"
set_global_assignment -name VERILOG_FILE "C:/Users/Aluno/Projetos/port_CycloneV_acc/pc_counter.v"
set_global_assignment -name VERILOG_FILE "C:/Users/Aluno/Projetos/port_CycloneV_acc/rom.v"
set_global_assignment -name VERILOG_FILE "C:/Users/Aluno/Projetos/port_CycloneV_acc/processtest00.v"
set_global_assignment -name VERILOG_FILE lace_board_top.v
set_global_assignment -name SDC_FILE lace_board_top.sdc

# The pins of the signals in use, from the board manual.
set_location_assignment PIN_R20 -to CLOCK_50_B5B
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50_B5B
set_location_assignment PIN_P11 -to KEY[0]
set_instance_assignment -name IO_STANDARD "1.2 V" -to KEY[0]
